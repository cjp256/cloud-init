flowchart TD
    A{Secrets Enabled?}
    
    %% Secrets enabled path
    A -->|Yes| I[Import Secrets Library]
    I --> J{Import OK?}
    J -->|No| K[Report failure: reason=missing azure_secrets dependency]

    %% Version handling
    J -->|Yes| M{Check Protocol Version}
    M -->|disabled| NORMAL[Normal Provisioning]
    
    %% V1 decryption flow
    M -->|v1| O[Decrypt V1 Fields]
    O --> Q{Custom Data OK?}
    Q -->|No| R[Report failure: reason=failed to decrypt customData]
    Q -->|Yes| T{Admin Password OK?}
    T -->|No| V[Report failure: reason=failed to decrypt adminPassword]
    T -->|Yes| W{Metadata Valid?}
    W -->|No| AA[Report failure: reason=failed to validate signed metadata]
    W -->|Yes| NORMAL

    %% Typical path - secrets disabled
    A -->|No| B[Normal Provisioning]
    B --> C{Unexpected Secrets?}
    C -->|Yes| D[Misinterpreted adminPassword, customData fails to decode]
    C -->|No| NORMAL
    
    %% Styling
    classDef successStyle fill:#90EE90,stroke:#2d6b2d,stroke-width:2px
    classDef errorStyle fill:#FFB6C6,stroke:#8b0000,stroke-width:2px
    classDef processStyle fill:#87CEEB,stroke:#4682b4,stroke-width:2px
    classDef decisionStyle fill:#FFE4B5,stroke:#ff8c00,stroke-width:2px
    
    class NORMAL,END successStyle
    class D,K,R,V,AA errorStyle
    class B,I,O processStyle
    class A,C,J,M,Q,T,W decisionStyle