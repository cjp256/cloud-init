
#!/bin/sh

set -e

# Pass maintainer script parameters to hook scripts
export DEB_MAINT_PARAMS="$*"

# Tell initramfs builder whether it's wanted
export INITRD=Yes

test -d /etc/kernel/preinst.d && run-parts --arg="6.8.12-decui.decui.2026.0401.0002" --arg="/boot/vmlinuz-6.8.12-decui.decui.2026.0401.0002" /etc/kernel/preinst.d
exit 0
