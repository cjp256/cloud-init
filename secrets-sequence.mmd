sequenceDiagram
    participant User
    participant CloudInit
    participant AzureSecrets
    participant Wireserver

    User->>CloudInit: Start provisioning
    
    alt Secrets Enabled?
        CloudInit->>CloudInit: Import Secrets Library
        
        alt Import OK?
            CloudInit->>AzureSecrets: Get Protocol Version
            
            alt disabled
                CloudInit->>CloudInit: Normal Provisioning
            else v1
                CloudInit->>AzureSecrets: Decrypt V1 Fields
                
                alt Custom Data OK?
                    AzureSecrets-->>CloudInit: Custom data decrypted
                    
                    alt Admin Password OK?
                        AzureSecrets-->>CloudInit: Password decrypted
                        
                        alt Metadata Valid?
                            CloudInit->>CloudInit: Normal Provisioning
                        else validation failed
                            CloudInit->>Wireserver: Report failure: reason=failed to validate signed metadata
                        end
                    else decryption failed
                        CloudInit->>Wireserver: Report failure: reason=failed to decrypt adminPassword
                    end
                else decryption failed
                    CloudInit->>Wireserver: Report failure: reason=failed to decrypt customData
                end
            end
        else import failed
            CloudInit->>Wireserver: Report failure: reason=missing azure_secrets dependency
        end
    else Secrets not enabled
        CloudInit->>CloudInit: Normal Provisioning
        
        opt Unexpected Secrets?
            CloudInit->>User: Misinterpreted adminPassword, customData fails to decode
        end
    end
