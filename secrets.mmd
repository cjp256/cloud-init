flowchart TD
    %% Node declarations
    SECRETS_ENABLED{Secrets Enabled?}
    IS_CVM{Is CVM?}
    IMPORT_LIB[Import Secrets Library]
    IMPORT_OK{Import OK?}
    IMPORT_FAIL[Report failure to Wireserver: reason=missing azure_secrets dependency]
    GET_VERSION[Get Protocol Version from Azure Secrets]
    PROTOCOL_VERSION{Protocol Version?}
    DECRYPT_V1[Decrypt V1 Fields]
    CUSTOM_DATA_OK{CustomData OK?}
    ADMIN_PASSWORD_OK{AdminPassword OK?}
    DECRYPT_FAIL["Report failure to Wireserver: reason=failed to decrypt ovf-env.xml field=&lt;name&gt;"]
    VALIDATE_METADATA[Validate Instance Metadata]
    SIGNATURE_INFO_VALID{signatureInfo OK?}
    USERDATA_VALID{userData OK?}
    VMID_VALID{vmId OK?}
    PUBLICKEYS_VALID{publicKeys OK?}
    SUBSCRIPTIONID_VALID{subscriptionId OK?}
    IMDS_VALIDATION_FAIL["Report failure to Wireserver: reason=failed to validate IMDS field=&lt;name&gt;"]
    PROTOCOL_VERSION_FAIL[Report failure to Wireserver: reason=unknown secrets provisioning protocol version]
    CONTINUE_PROV[Continue Provisioning]
    NORMAL_PROV[Normal Provisioning]
    UNEXPECTED_SECRETS{Unexpected Secrets?}
    MISINTERPRETED[Misinterpreted adminPassword, customData fails to decode, exact failure modes TBD]
    
    %% Secrets enabled path
    SECRETS_ENABLED -->|Yes| IS_CVM
    IS_CVM -->|Yes| IMPORT_LIB
    IS_CVM -->|No| NORMAL_PROV
    IMPORT_LIB --> IMPORT_OK
    IMPORT_OK -->|No| IMPORT_FAIL

    %% Version handling
    IMPORT_OK -->|Yes| GET_VERSION
    GET_VERSION --> PROTOCOL_VERSION
    PROTOCOL_VERSION -->|disabled| CONTINUE_PROV
    PROTOCOL_VERSION -->|unknown| PROTOCOL_VERSION_FAIL
    
    %% V1 decryption flow
    PROTOCOL_VERSION -->|v1| DECRYPT_V1
    DECRYPT_V1 --> CUSTOM_DATA_OK
    CUSTOM_DATA_OK -->|No| DECRYPT_FAIL
    CUSTOM_DATA_OK -->|Yes| ADMIN_PASSWORD_OK
    ADMIN_PASSWORD_OK -->|No| DECRYPT_FAIL
    ADMIN_PASSWORD_OK -->|Yes| VALIDATE_METADATA
    VALIDATE_METADATA --> SIGNATURE_INFO_VALID
    SIGNATURE_INFO_VALID -->|No| IMDS_VALIDATION_FAIL
    SIGNATURE_INFO_VALID -->|Yes| USERDATA_VALID
    USERDATA_VALID -->|No| IMDS_VALIDATION_FAIL
    USERDATA_VALID -->|Yes| VMID_VALID
    VMID_VALID -->|No| IMDS_VALIDATION_FAIL
    VMID_VALID -->|Yes| PUBLICKEYS_VALID
    PUBLICKEYS_VALID -->|No| IMDS_VALIDATION_FAIL
    PUBLICKEYS_VALID -->|Yes| SUBSCRIPTIONID_VALID
    SUBSCRIPTIONID_VALID -->|No| IMDS_VALIDATION_FAIL
    SUBSCRIPTIONID_VALID -->|Yes| CONTINUE_PROV

    %% Typical path - secrets disabled
    SECRETS_ENABLED -->|No| NORMAL_PROV
    NORMAL_PROV --> UNEXPECTED_SECRETS
    UNEXPECTED_SECRETS -->|Yes| MISINTERPRETED
    UNEXPECTED_SECRETS -->|No| CONTINUE_PROV
    
    %% Styling
    classDef successStyle fill:#90EE90,stroke:#2d6b2d,stroke-width:2px
    classDef errorStyle fill:#FFB6C6,stroke:#8b0000,stroke-width:2px
    classDef processStyle fill:#87CEEB,stroke:#4682b4,stroke-width:2px
    classDef decisionStyle fill:#FFE4B5,stroke:#ff8c00,stroke-width:2px
    
    class CONTINUE_PROV successStyle
    class MISINTERPRETED,IMPORT_FAIL,DECRYPT_FAIL,PROTOCOL_VERSION_FAIL,IMDS_VALIDATION_FAIL errorStyle
    class NORMAL_PROV,IMPORT_LIB,DECRYPT_V1,VALIDATE_METADATA processStyle
    class SECRETS_ENABLED,UNEXPECTED_SECRETS,IMPORT_OK,GET_VERSION,PROTOCOL_VERSION,CUSTOM_DATA_OK,ADMIN_PASSWORD_OK,IS_CVM,SIGNATURE_INFO_VALID,USERDATA_VALID,VMID_VALID,PUBLICKEYS_VALID,SUBSCRIPTIONID_VALID decisionStyle